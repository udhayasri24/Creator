# ==========================================
# CreatorIQ - Environment Configuration Example
# Milestone 1: Foundation & UI Shell
# Copy this file to .env and adjust your settings
# ==========================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=creatoriq-super-secret-key-change-in-production

# MySQL Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/creatoriq_db

# Granular MySQL Parameters (Alternative to DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password123
MYSQL_DB=creatoriq_db
